<idea-plugin url="https://github.com/VPDPersonal/Aspid.PreviewScroll" require-restart="false">
    <id>com.aspid.previewscroll</id>
    <name>Aspid.PreviewScroll</name>
    <vendor url="https://github.com/VPDPersonal" email="vpd.aspid@gmail.com">Vladislav Panin</vendor>

    <description><![CDATA[
        <p>Scroll the selected file while your keyboard focus stays in the project tree.</p>
        <p>Scroll by lines, columns, or pages in a preview or regular editor tab. Use the arrow keys
        to move between files. Set the vertical and horizontal scroll steps under
        Settings &gt; Tools &gt; Aspid.PreviewScroll.</p>
        <p>Requires IntelliJ Platform 2026.3 or later.</p>
    ]]></description>

    <change-notes><![CDATA[
        <p>Initial release with vertical, horizontal, and page scrolling from the project tree.
        The vertical and horizontal scroll steps can be configured independently.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="tools"
                                 instance="com.aspid.previewscroll.PreviewScrollConfigurable"
                                 id="com.aspid.previewscroll.PreviewScrollConfigurable"
                                 displayName="Aspid.PreviewScroll"/>
    </extensions>

    <actions>
        <action id="com.aspid.previewscroll.ScrollDown"
                class="com.aspid.previewscroll.ScrollPreviewDownAction"
                text="Scroll Preview Down"
                description="Scrolls the editor of the selected file down without leaving the tree">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift DOWN"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift DOWN" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift DOWN" replace-all="true"/>
        </action>

        <action id="com.aspid.previewscroll.ScrollUp"
                class="com.aspid.previewscroll.ScrollPreviewUpAction"
                text="Scroll Preview Up"
                description="Scrolls the editor of the selected file up without leaving the tree">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift UP"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift UP" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift UP" replace-all="true"/>
        </action>

        <action id="com.aspid.previewscroll.ScrollLeft"
                class="com.aspid.previewscroll.ScrollPreviewLeftAction"
                text="Scroll Preview Left"
                description="Scrolls the editor of the selected file left without leaving the tree">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift LEFT"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift LEFT" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift LEFT" replace-all="true"/>
        </action>

        <action id="com.aspid.previewscroll.ScrollRight"
                class="com.aspid.previewscroll.ScrollPreviewRightAction"
                text="Scroll Preview Right"
                description="Scrolls the editor of the selected file right without leaving the tree">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift RIGHT"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift RIGHT" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift RIGHT" replace-all="true"/>
        </action>

        <action id="com.aspid.previewscroll.ScrollPageDown"
                class="com.aspid.previewscroll.ScrollPreviewPageDownAction"
                text="Scroll Preview Page Down"
                description="Scrolls the editor of the selected file one page down without leaving the tree">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift PAGE_DOWN"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift PAGE_DOWN" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift PAGE_DOWN" replace-all="true"/>
        </action>

        <action id="com.aspid.previewscroll.ScrollPageUp"
                class="com.aspid.previewscroll.ScrollPreviewPageUpAction"
                text="Scroll Preview Page Up"
                description="Scrolls the editor of the selected file one page up without leaving the tree">
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift PAGE_UP"/>
            <keyboard-shortcut keymap="Mac OS X" first-keystroke="meta alt shift PAGE_UP" replace-all="true"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift PAGE_UP" replace-all="true"/>
        </action>
    </actions>
</idea-plugin>
